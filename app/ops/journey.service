[Unit]
Description=Journey collaborative travel planner
After=network.target

[Service]
Type=simple
User=journey
Group=journey
WorkingDirectory=/opt/journey/current
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=256
EnvironmentFile=/etc/journey/journey.env
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillSignal=SIGTERM
UMask=0077
StateDirectory=journey
StateDirectoryMode=0700
ReadWritePaths=/var/lib/journey
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
CPUQuota=40%
CPUWeight=10
IOWeight=10
IOSchedulingClass=idle
Nice=10
MemoryHigh=384M
MemoryMax=512M
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
