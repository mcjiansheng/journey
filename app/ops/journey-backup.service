[Unit]
Description=Encrypted Journey SQLite backups
After=journey.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/journey/current
EnvironmentFile=/etc/journey/journey.env
ExecStart=/usr/bin/node ops/backup.mjs backup
UMask=0077
Nice=19
IOSchedulingClass=idle
CPUQuota=10%
CPUWeight=1
MemoryHigh=192M
MemoryMax=256M
TimeoutStartSec=20min
ProtectSystem=strict
ReadWritePaths=/var/lib/journey /var/backups/journey
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_FOWNER
