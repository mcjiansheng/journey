HOST=127.0.0.1
PORT=4177
APP_ORIGIN=https://journey.jscloud.wang
BASE_PATH=/
COOKIE_SECURE=true
TRUST_PROXY=loopback
DATABASE_PATH=/var/lib/journey/journey.sqlite
SECURITY_DATABASE_PATH=/var/lib/journey/security.sqlite
BACKUP_KEY_PATH=/etc/journey/backup.key
BACKUP_DIR=/var/backups/journey
# 地图配置文件 root:journey 0640；含公开 JS Key 和安全密钥。
AMAP_CONFIG_FILE=/etc/journey/amap.json
