{
  "name": "journey",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/finalize-build.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=../.local/browsers playwright test",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.10"
  }
}
